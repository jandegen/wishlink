{
  "name": "wishlink",
  "version": "1.0.0",
  "description": "Wish list application: share wishes, let others claim them - without the owner ever seeing it.",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "lint": "node --check src/server.js && node --check public/app.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
