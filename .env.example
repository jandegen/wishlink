WISHLINK_PORT=3000
PUBLIC_URL=http://localhost:3000
TRUST_PROXY=false
# OIDC (Keycloak) – leave OIDC_ISSUER empty to disable
OIDC_ISSUER=
OIDC_CLIENT_ID=wishlink
OIDC_CLIENT_SECRET=
# Shown in the privacy notice on the login page ("data is stored on <name>'s private server")
OPERATOR_NAME=
# Initial admin (created on first start; change the password afterwards on the Konto page)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Pin a release instead of always running the latest one:
# WISHLINK_IMAGE=ghcr.io/jandegen/wishlink:1.0.1
# Behind Traefik (docker-compose.traefik.yml):
# WISHLINK_HOST=wishlink.example.com
# TRAEFIK_NETWORK=web
# TRAEFIK_CERTRESOLVER=letsencrypt
